# Address the web server uses to reach the API.
API_INTERNAL_URL=http://localhost:4000

# Public address of the store, used in the sitemap and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Leave empty in development: images come from apps/web/public.
NEXT_PUBLIC_IMAGE_BASE_URL=

# Shared with the API to refresh cached catalog pages. Use a long random value.
REVALIDATE_SECRET=dev-only-secret
