{
  "name": "@aurevi/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "prisma generate && nest start --watch",
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "pnpm exec prisma migrate deploy --config prisma.test.config.ts && node --import tsx --test test/*.test.ts",
    "lint": "eslint src test prisma/seed.ts --config ../../eslint.config.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@aurevi/shared": "workspace:*",
    "@nestjs/common": "12.3.3",
    "@nestjs/core": "12.3.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/schedule": "12.0.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.11",
    "@types/express": "5.0.6",
    "@types/node": "26.6.6",
    "prisma": "7.10.1",
    "tsx": "4.23.15"
  }
}
