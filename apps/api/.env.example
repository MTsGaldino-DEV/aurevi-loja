# Local development values. Copy to .env, which is never committed.
DATABASE_URL=postgresql://aurevi:aurevi_dev@localhost:5433/aurevi
API_PORT=4000

# Signs order links. At least 32 characters; use a long random value in production.
ORDER_TOKEN_SECRET=dev-only-secret-dev-only-secret-dev

# Integration tests use their own database, which they empty on every run.
TEST_DATABASE_URL=postgresql://aurevi:aurevi_dev@localhost:5433/aurevi_test

# Optional: creates the first admin user when running db:seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-use
