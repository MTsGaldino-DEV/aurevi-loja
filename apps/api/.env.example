# Local development values. Copy to .env, which is never committed.
DATABASE_URL=postgresql://aurevi:aurevi_dev@localhost:5433/aurevi
API_PORT=4000

# Signs order links. At least 32 characters; use a long random value in production.
ORDER_TOKEN_SECRET=dev-only-secret-dev-only-secret-dev

# Integration tests use their own database, which they empty on every run.
TEST_DATABASE_URL=postgresql://aurevi:aurevi_dev@localhost:5433/aurevi_test

# Optional: creates the first admin user when running db:seed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-use

# Mercado Pago: panel, your application, "Teste" environment, "Credenciais". Secret, API only.
MP_ACCESS_TOKEN=
# Mercado Pago: panel, "Webhooks > Configurar notificações", shown after saving the URL.
# Without it the store runs, but webhooks are refused and Mercado Pago retries them later.
MP_WEBHOOK_SECRET=

# Melhor Envio: enable after creating an application in the selected environment.
MELHOR_ENVIO_ENVIRONMENT=sandbox
# MELHOR_ENVIO_CLIENT_ID=123
# MELHOR_ENVIO_CLIENT_SECRET=your-app-secret
# Use the same public HTTPS callback in the app registration and here.
# MELHOR_ENVIO_REDIRECT_URI=https://your-public-test-host/api/health
# MELHOR_ENVIO_USER_AGENT=Aurevi (your-technical-email@example.com)
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this key when restarting or restoring the database. Tokens are encrypted with it.
# INTEGRATION_ENCRYPTION_KEY=64-hex-characters

# Admin panel origins allowed to POST/PATCH/DELETE (comma-separated). Defaults to http://localhost:3000.
# ADMIN_ALLOWED_ORIGINS=http://localhost:3000
